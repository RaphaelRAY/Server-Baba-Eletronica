# .env
HOST=0.0.0.0
PORT=8000
RELOAD=true

CAM_HOST=192.168.0.176
CAM_PORT=80
CAM_USER=admin
CAM_PASS=123456

# Banco de dados (use UM dos URLs abaixo):
# SQL (SQLite/MySQL/Postgres via SQLAlchemy)
# DB_URL=sqlite:///./events.db
# DB_URL=mysql+pymysql://user:pass@localhost:3306/tcc
# DB_URL=postgresql://user:pass@localhost:5432/tcc
# MongoDB (usa pymongo; se não houver DB no URL, use MONGO_DB)
# DB_URL=mongodb://localhost:27017/baby_monitor
# MONGO_DB=baby_monitor
# MONGO_COLLECTION=events
FIREBASE_CRED=
FCM_KEY=
EVENTS_DIR=data/events

# Fonte de vídeo: onvif|rtsp|file|device
VIDEO_SOURCE=onvif
# Para rtsp:
# RTSP_URL=rtsp://user:pass@ip:554/stream
# Para file:
# VIDEO_PATH=/caminho/para/video.mp4
# Para device (webcam):
# DEVICE_INDEX=0

# Sincronizar reprodução de arquivo para FPS original (ou FILE_FPS)
SYNC_FILE_FPS=true
# Use quando o arquivo não reporta FPS corretamente
# FILE_FPS=30

# FPS do endpoint /api/stream (padrão: usa FILE FPS ou 15)
# STREAM_FPS=15

# CORS (comma-separated list or "*")
# Example for local frontend dev server:
CORS_ORIGINS=http://localhost:54004
# If you need cookies/Authorization across origins, set to true
CORS_ALLOW_CREDENTIALS=false

# Cooldown para push notifications (segundos)
# NOTIFIER_COOLDOWN_SECS=60

# De-duplicação de eventos (cooldown global em segundos)
# EVENT_COOLDOWN_SECS=60
# Overrides por tipo (exemplos):
# EVENT_COOLDOWN_absence=300
# EVENT_COOLDOWN_camera_disconnected=30
# EVENT_COOLDOWN_camera_connected=10
# EVENT_COOLDOWN_face_down=60
# EVENT_COOLDOWN_face_down_suspected=120

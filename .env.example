###############################################
# Exemplo de .env — Baby Monitor (FastAPI)
#
# Dica: mantenha variáveis opcionais comentadas.
# Seção indica se é obrigatório, opcional ou condicional.
###############################################

########## Execução e Logs (opcional) ##########
# Nível de log: DEBUG | INFO | WARNING | ERROR | CRITICAL (padrão: INFO)
# LOG_LEVEL=INFO
# Logs detalhados de envio FCM (true/false; padrão: false)
# FCM_LOG_DETAILS=false
# Exibir eventos suprimidos por cooldown nos logs (true/false; padrão: false)
# EVENT_LOG_SUPPRESSED=false
#
# Observação: as variáveis abaixo são usadas apenas se você rodar uvicorn manualmente.
# O src/main.py usa host="localhost" e port=8000 diretamente.
# HOST=0.0.0.0
# PORT=8000
# RELOAD=true

########## Fonte de Vídeo (obrigatório/condicional) ##########
# Escolha a fonte: onvif | rtsp | file | device (padrão: onvif)
VIDEO_SOURCE=onvif

# ONVIF (obrigatório se VIDEO_SOURCE=onvif)
CAM_HOST=192.168.0.176
CAM_PORT=80
CAM_USER=admin
CAM_PASS=123456

# RTSP (obrigatório se VIDEO_SOURCE=rtsp)
RTSP_URL=rtsp://user:pass@ip:554/stream

# Arquivo (obrigatório se VIDEO_SOURCE=file)
VIDEO_PATH=/caminho/para/video.mp4
# Sincronizar playback com FPS de origem (padrão: true)
SYNC_FILE_FPS=true
# Use quando o arquivo não reporta FPS corretamente
FILE_FPS=30

# Dispositivo (webcam) — (condicional se VIDEO_SOURCE=device)
DEVICE_INDEX=0

########## Streaming (opcional) ##########
# FPS do endpoint /api/stream (padrão: usa FPS do arquivo ou 15)
# STREAM_FPS=15

########## CORS (opcional) ##########
# Lista separada por vírgulas de origens permitidas ou "*" (padrão: "*")
# Ex.: permitir frontend local
# CORS_ORIGINS=http://localhost:54004
# Permite cookies/Authorization entre origens (padrão: false)
# CORS_ALLOW_CREDENTIALS=false

########## Banco de Dados (opcional) ##########
# Se não definir, usa armazenamento em memória.
# Use APENAS UM dos URLs abaixo.
# SQL (SQLite/MySQL/Postgres via SQLAlchemy)
# DB_URL=sqlite:///./events.db
# DB_URL=mysql+pymysql://user:pass@localhost:3306/tcc
# DB_URL=postgresql://user:pass@localhost:5432/tcc
# Alternativamente, algumas libs usam DATABASE_URL (mesmo formato):
# DATABASE_URL=postgresql://user:pass@localhost:5432/tcc
# MongoDB (usa pymongo; se o URL não especifica DB, use MONGO_DB)
# DB_URL=mongodb://localhost:27017/baby_monitor
# MONGO_DB=baby_monitor
# MONGO_COLLECTION=events

########## Firebase e Push (opcional) ##########
# Caminho do JSON de credenciais do Firebase Admin SDK
# Se não informado, tenta Application Default Credentials (ADC)
# FIREBASE_CRED=/caminho/serviceAccountKey.json
# Chave de API para serviços relacionados (FCM direto, se aplicável)
# FCM_KEY=
# Cooldown entre notificações push (segundos; padrão: 60)
# NOTIFIER_COOLDOWN_SECS=60

########## Eventos e Armazenamento (opcional) ##########
# Diretório para salvar imagens de eventos (padrão: data/events)
# EVENTS_DIR=data/events
# De-duplicação global (cooldown entre eventos iguais em segundos)
# EVENT_COOLDOWN_SECS=60
# Overrides por tipo (exemplos):
# EVENT_COOLDOWN_absence=300
# EVENT_COOLDOWN_camera_disconnected=30
# EVENT_COOLDOWN_camera_connected=10
# EVENT_COOLDOWN_face_down=60
# EVENT_COOLDOWN_face_down_suspected=120

########## Detecção de Posição (opcional) ##########
# Mostrar janela de debug com poses (padrão: true)
# SHOW_POSE_WINDOW=true
# Confiança mínima para considerar face visível (padrão: 0.3)
# POSE_FACE_CONF_MIN=0.3
# Quadros consecutivos sem face para suspeita (padrão: 12)
# POSE_NO_FACE_FRAMES=12

########## Monitoramento da Câmera (opcional) ##########
# Sinaliza desconexão após X segundos sem frames (>0 para ativar)
# CAM_DISCONNECT_SECS=0
# Sinaliza desconexão após N frames None consecutivos (>0 para ativar)
# CAM_DISCONNECT_MISSES=0

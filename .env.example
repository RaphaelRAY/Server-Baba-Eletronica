# .env
HOST=0.0.0.0
PORT=8000
RELOAD=true

CAM_HOST=192.168.0.176
CAM_PORT=80
CAM_USER=admin
CAM_PASS=123456

DATABASE_URL=postgresql://user:pass@localhost:5432/tcc
FIREBASE_CRED=
FCM_KEY=
EVENTS_DIR=data/events

# Fonte de vídeo: onvif|rtsp|file|device
VIDEO_SOURCE=onvif
# Para rtsp:
# RTSP_URL=rtsp://user:pass@ip:554/stream
# Para file:
# VIDEO_PATH=/caminho/para/video.mp4
# Para device (webcam):
# DEVICE_INDEX=0

# Sincronizar reprodução de arquivo para FPS original (ou FILE_FPS)
SYNC_FILE_FPS=true
# Use quando o arquivo não reporta FPS corretamente
# FILE_FPS=30

# FPS do endpoint /api/stream (padrão: usa FILE FPS ou 15)
# STREAM_FPS=15

# CORS (comma-separated list or "*")
# Example for local frontend dev server:
CORS_ORIGINS=http://localhost:54004
# If you need cookies/Authorization across origins, set to true
CORS_ALLOW_CREDENTIALS=false
